# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Pooler connection — used by Next.js / Prisma at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct connection — used by prisma db push / migrate
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ─── Resend (transactional email) ─────────────────────────────────────────────
RESEND_API_KEY="re_your_key_here"

# From address shown in sent emails — must be a verified domain in Resend
EMAIL_FROM="Tyckety.cz <noreply@example.com>"

# ─── App ─────────────────────────────────────────────────────────────────────
# Public base URL — used in email links and QR code URLs
APP_URL="https://example.com"

# ─── Super admin ─────────────────────────────────────────────────────────────
# Comma-separated emails with access to /internal and /api/internal/**
SUPER_ADMIN_EMAILS="admin@example.com"
